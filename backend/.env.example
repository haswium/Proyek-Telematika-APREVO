# Salin menjadi .env lalu isi nilainya. Jangan commit .env.
SUPABASE_URL=
# Kunci anon, sama dengan yang dipakai aplikasi Flutter.
SUPABASE_KEY=
# Kunci service_role. Hanya untuk backend, jangan pernah masuk ke Flutter.
SUPABASE_SERVICE_KEY=

# Isi 1 untuk menyalakan /test-login, /test-supabase, /debug-auth, /debug-policy.
ENABLE_DEBUG_ENDPOINTS=0
# Akun uji untuk /test-login. Jangan pakai akun asli.
TEST_LOGIN_EMAIL=
TEST_LOGIN_PASSWORD=

# Origin tambahan di luar localhost dan IP lokal, pisahkan dengan koma.
CORS_ORIGINS=

# Kunci Gemini untuk AI soal dan deskripsi gambar. Kalau kosong, backend
# tetap menyala, hanya endpoint AI yang menolak.
GEMINI_API_KEY=
# Jeda (detik) antar panggilan Gemini saat membuat deskripsi gambar, supaya
# tidak kena batas pemakaian versi gratis. Kosong = 4.
GEMINI_DELAY_SECONDS=
# Jeda tambahan (detik) setelah Gemini menjawab batas pemakaian. Kosong = 30.
GEMINI_RATE_LIMIT_PAUSE_SECONDS=
